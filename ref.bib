% 見本デッキ用の文献の例（実在しない書誌）。自分の文献に置き換えて使う。
% 題名の固有名詞は {} で囲む（APA は題名を小文字化するため。例: {Japan}）

@article{example2020,
  author  = {Author, Alice and Coauthor, Bob},
  title   = {Title of the First Example Article in {Japan}},
  journal = {Journal Name},
  year    = {2020},
  volume  = {1},
  number  = {1},
  pages   = {1--20}
}

@article{example2021,
  author  = {Writer, Carol},
  title   = {Title of the Second Example Article},
  journal = {Another Journal Name},
  year    = {2021},
  volume  = {2},
  number  = {3},
  pages   = {100--130}
}

@article{example2022,
  author  = {Researcher, Dan and Scholar, Eve and Analyst, Frank},
  title   = {Title of the Third Example Article on a Method},
  journal = {Journal of Methods},
  year    = {2022},
  volume  = {10},
  number  = {2},
  pages   = {50--75}
}
